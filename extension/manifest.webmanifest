{
  "name": "Schematic Net Tracer",
  "short_name": "Net Tracer",
  "description": "Click a wire in a PDF schematic and see where it goes. Runs locally in the browser.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#14171c",
  "theme_color": "#1d2128",
  "icons": [
    { "src": "icons/icon192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon512.png", "sizes": "512x512", "type": "image/png", "purpose": "any maskable" }
  ],
  "share_target": {
    "action": "./share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": { "files": [ { "name": "pdf", "accept": ["application/pdf", ".pdf"] } ] }
  },
  "file_handlers": [ { "action": "./", "accept": { "application/pdf": [".pdf"] } } ]
}
